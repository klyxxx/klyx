# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/blob-report/
playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Supabase local/link metadata
supabase/.temp/

# KLYX local safety
*.bak
.klyx-local-backup/
reports/master-audit/
reports/master-audit/*.log
/build-*-error.txt
reports/*-typescript-errors.txt

# KLYX encrypted disaster-recovery archives
*.klyxdr
*.klyxdr.sha256
*.klyxdr.zip

# Database dump artifacts
*.dump
*.dump.gz
*.sql.dump
*.sql.gz
# KLYX transient rebuild workspaces
.klyx-baseline-rebuild-*/
.klyx-fidelity-rebuild-*/
.klyx-local-rebuild-*/

# KLYX generated repository archives
repository-archive-*/

# KLYX generated reports - keep only continuity reports
/reports/*
!/reports/continuity/
!/reports/continuity/**
