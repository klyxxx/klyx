{
  "name": "klyx-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "sync:i18n": "node scripts/sync-tolgee.mjs",
    "postinstall": "npm run sync:i18n",
    "start": "npm run sync:i18n && expo start --dev-client",
    "android": "npm run sync:i18n && expo run:android",
    "ios": "npm run sync:i18n && expo run:ios",
    "prebuild": "npm run sync:i18n && expo prebuild",
    "typecheck": "npm run sync:i18n && tsc --noEmit",
    "doctor": "npx expo-doctor",
    "export": "expo export --platform all --output-dir dist"
  },
  "dependencies": {
    "@sumsub/react-native-mobilesdk-module": "1.46.1",
    "@supabase/supabase-js": "^2.111.0",
    "expo": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-notifications": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-url-polyfill": "4.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
