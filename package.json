{
  "name": "klyx",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:watch": "vitest",
    "test:ci": "vitest run --reporter=verbose",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "perf:k6:smoke": "k6 run -e KLYX_PERF_PROFILE=smoke performance/k6/klyx-readonly.js",
    "perf:k6:ci": "k6 run -e KLYX_PERF_PROFILE=ci performance/k6/klyx-readonly.js",
    "perf:k6:load": "k6 run -e KLYX_PERF_PROFILE=load performance/k6/klyx-readonly.js",
    "perf:k6:stress": "k6 run -e KLYX_PERF_PROFILE=stress performance/k6/klyx-readonly.js",
    "perf:k6:spike": "k6 run -e KLYX_PERF_PROFILE=spike performance/k6/klyx-readonly.js",
    "perf:k6:soak": "k6 run -e KLYX_PERF_PROFILE=soak performance/k6/klyx-readonly.js",
    "perf:ab": "powershell -ExecutionPolicy Bypass -File scripts/performance/ab-local.ps1"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@sumsub/websdk-react": "^2.8.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "next": "^16.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.16.0",
    "stripe": "^22.4.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "supabase": "^2.114.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "22.x"
  }
}
