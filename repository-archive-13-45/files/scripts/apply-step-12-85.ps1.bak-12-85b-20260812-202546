$ErrorActionPreference = "Stop"

$root = Split-Path -Parent $PSScriptRoot

$migrationPath = Join-Path $root "supabase\migrations\20260812202000_klyx_booking_groups_12_85.sql"
$createApiPath = Join-Path $root "app\api\market\requests\[id]\group-booking\route.ts"
$groupApiPath = Join-Path $root "app\api\booking-groups\[id]\route.ts"
$groupPagePath = Join-Path $root "app\booking-groups\[id]\page.tsx"
$advicePagePath = Join-Path $root "app\assistant\market\[id]\page.tsx"
$brainActionsPath = Join-Path $root "lib\brain-actions.ts"
$statusPath = Join-Path $root "app\api\bookings\status\route.ts"
$checkoutPath = Join-Path $root "app\api\stripe\create-checkout-session\route.ts"

foreach ($required in @($advicePagePath, $brainActionsPath, $statusPath, $checkoutPath)) {
    if (-not (Test-Path -LiteralPath $required)) {
        throw "Fichier requis introuvable : $required"
    }
}

New-Item -ItemType Directory -Force -Path (Split-Path -Parent $migrationPath) | Out-Null
New-Item -ItemType Directory -Force -Path (Split-Path -Parent $createApiPath) | Out-Null
New-Item -ItemType Directory -Force -Path (Split-Path -Parent $groupApiPath) | Out-Null
New-Item -ItemType Directory -Force -Path (Split-Path -Parent $groupPagePath) | Out-Null

$utf8 = New-Object System.Text.UTF8Encoding($false)

function Decode([string]$Value) {
    [System.Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($Value))
}

$migration = Decode ""
$createApi = Decode ""
$groupApi = Decode ""
$groupPage = Decode ""
$adviceFunctions = Decode ""
$oldMultiButton = Decode ""
$newMultiButton = Decode ""

$timestamp = Get-Date -Format "yyyyMMdd-HHmmss"

foreach ($path in @($advicePagePath, $brainActionsPath, $statusPath, $checkoutPath)) {
    Copy-Item -LiteralPath $path -Destination ($path + ".bak-12-85-" + $timestamp) -Force
}

[System.IO.File]::WriteAllText($migrationPath, $migration, $utf8)
[System.IO.File]::WriteAllText($createApiPath, $createApi, $utf8)
[System.IO.File]::WriteAllText($groupApiPath, $groupApi, $utf8)
[System.IO.File]::WriteAllText($groupPagePath, $groupPage, $utf8)

# ===========================================================
# PATCH MARKET ADVICE
# ===========================================================

$advice = [System.IO.File]::ReadAllText($advicePagePath)

if (-not $advice.Contains("KLYX_GROUP_SELECTION_UI_12_85")) {
    $functionsStart = $advice.IndexOf("  function prepareChoice(")
    $functionsEnd = $advice.IndexOf("  if (loading) {", $functionsStart)

    if ($functionsStart -lt 0 -or $functionsEnd -lt 0) {
        throw "12.85 : fonctions de selection Market introuvables."
    }

    $advice = $advice.Substring(0, $functionsStart) + $adviceFunctions + $advice.Substring($functionsEnd)

    if (-not $advice.Contains($oldMultiButton)) {
        throw "12.85 : bouton multi-slot 12.84 introuvable."
    }

    $advice = $advice.Replace($oldMultiButton, $newMultiButton)
}

[System.IO.File]::WriteAllText($advicePagePath, $advice, $utf8)

# ===========================================================
# PATCH BRAIN ACTIONS
# ===========================================================

$brain = [System.IO.File]::ReadAllText($brainActionsPath)

if (-not $brain.Contains("KLYX_GROUP_ACTIONS_12_85")) {
    $typeAnchor = "  quote_id: string | null;`n  status: string;"

    if (-not $brain.Contains($typeAnchor)) {
        throw "12.85 : BookingRow Brain introuvable."
    }

    $brain = $brain.Replace(
        $typeAnchor,
        "  quote_id: string | null;`n  booking_group_id: string | null;`n  status: string;"
    )

    $brain = $brain.Replace(
        "quote_id, status, payment_status",
        "quote_id, booking_group_id, status, payment_status"
    )

    $clientAnchor = @("
        if (",
        "          booking.status === ""accepted"" &&",
        "          booking.payment_status !== ""paid""",
        "        ) {"
    )

    $clientNeedle = [string]::Join("`n", $clientAnchor)

    if (-not $brain.Contains($clientNeedle)) {
        throw "12.85 : action paiement client introuvable."
    }

    $clientGroup = @("
        "        // KLYX_GROUP_ACTIONS_12_85",
        "        if (",
        "          booking.booking_group_id &&",
        "          booking.status === ""accepted"" &&",
        "          booking.payment_status !== ""paid""",
        "        ) {",
        "          addAction(actionMap, {",
        "            id: ""payment-group-"" + booking.booking_group_id,",
        "            kind: ""payment_pending"",",
        "            priority: 110,",
        "            title: ""Paiement groupe a finaliser"",",
        "            description: ""Tous les creneaux sont acceptes. Le groupe attend un paiement unique."",",
        "            href: ""/booking-groups/"" + booking.booking_group_id,",
        "            label: ""Voir le groupe"",",
        "          });",
        "          continue;",
        "        }",
        ""
    )

    $clientInsert = [string]::Join("`n", $clientGroup)
    $brain = $brain.Replace($clientNeedle, $clientInsert + $clientNeedle)

    $providerNeedle = "        if (booking.status === ""pending"") {"

    if (-not $brain.Contains($providerNeedle)) {
        throw "12.85 : action prestataire pending introuvable."
    }

    $providerGroup = @("
        "        if (",
        "          booking.booking_group_id &&",
        "          booking.status === ""pending""",
        "        ) {",
        "          addAction(actionMap, {",
        "            id: ""provider-group-"" + booking.booking_group_id,",
        "            kind: ""provider_booking_request"",",
        "            priority: 125,",
        "            title: ""Reservation groupee a confirmer"",",
        "            description: ""Le client t a selectionne pour plusieurs creneaux. Confirme le groupe complet."",",
        "            href: ""/booking-groups/"" + booking.booking_group_id,",
        "            label: ""Traiter le groupe"",",
        "          });",
        "          continue;",
        "        }",
        ""
    )

    $providerInsert = [string]::Join("`n", $providerGroup)
    $brain = $brain.Replace($providerNeedle, $providerInsert + $providerNeedle)
}

[System.IO.File]::WriteAllText($brainActionsPath, $brain, $utf8)

# ===========================================================
# BLOCK INDIVIDUAL GROUP STATUS
# ===========================================================

$status = [System.IO.File]::ReadAllText($statusPath)

if (-not $status.Contains("KLYX_GROUP_STATUS_GUARD_12_85")) {
    $status = $status.Replace(
        "  babysitter_id: string | null;`n  booking_date: string;",
        "  babysitter_id: string | null;`n  booking_group_id: string | null;`n  booking_date: string;"
    )

    $status = $status.Replace(
        "babysitter_id, booking_date, start_time",
        "babysitter_id, booking_group_id, booking_date, start_time"
    )

    $statusAnchor = "    const booking = data as BookingRow;"

    if (-not $status.Contains($statusAnchor)) {
        throw "12.85 : booking status anchor introuvable."
    }

    $statusGuard = @("
        "    const booking = data as BookingRow;",
        "",
        "    // KLYX_GROUP_STATUS_GUARD_12_85",
        "    if (booking.booking_group_id) {",
        "      return NextResponse.json(",
        "        {",
        "          error:",
        "            ""Cette reservation appartient a un groupe. Modifie le groupe complet depuis KLYX."",",
        "          code: ""GROUP_STATUS_REQUIRED"",",
        "          groupId: booking.booking_group_id,",
        "        },",
        "        { status: 409 }",
        "      );",
        "    }"
    )

    $status = $status.Replace(
        $statusAnchor,
        [string]::Join("`n", $statusGuard)
    )
}

[System.IO.File]::WriteAllText($statusPath, $status, $utf8)

# ===========================================================
# BLOCK INDIVIDUAL STRIPE PAYMENT
# ===========================================================

$checkout = [System.IO.File]::ReadAllText($checkoutPath)

if (-not $checkout.Contains("KLYX_GROUP_PAYMENT_GUARD_12_85")) {
    $checkout = $checkout.Replace(
        "  babysitter_id: string | null;`n  service_id: string | null;",
        "  babysitter_id: string | null;`n  booking_group_id: string | null;`n  service_id: string | null;"
    )

    $checkout = $checkout.Replace(
        "babysitter_id, service_id, user_service_id",
        "babysitter_id, booking_group_id, service_id, user_service_id"
    )

    $paymentAnchor = "    if (booking.parent_id !== profile.id) {"
    $paymentEndAnchor = "    if (booking.status !== ""accepted"") {"

    $paymentStart = $checkout.IndexOf($paymentAnchor)
    $paymentEnd = $checkout.IndexOf($paymentEndAnchor, $paymentStart)

    if ($paymentStart -lt 0 -or $paymentEnd -lt 0) {
        throw "12.85 : zone autorisation paiement introuvable."
    }

    $groupPaymentGuard = @("
        "    // KLYX_GROUP_PAYMENT_GUARD_12_85",
        "    if (booking.booking_group_id) {",
        "      return NextResponse.json(",
        "        {",
        "          error:",
        "            ""Cette reservation appartient a un groupe. Utilise le paiement groupe KLYX."",",
        "          code: ""GROUP_PAYMENT_REQUIRED"",",
        "          groupId: booking.booking_group_id,",
        "        },",
        "        { status: 409 }",
        "      );",
        "    }",
        ""
    )

    $guardText = [string]::Join("`n", $groupPaymentGuard)
    $checkout = $checkout.Insert($paymentEnd, $guardText)
}

[System.IO.File]::WriteAllText($checkoutPath, $checkout, $utf8)

Write-Host ""
Write-Host "======================================"
Write-Host "KLYX 12.85 APPLIQUE"
Write-Host "======================================"
Write-Host "Booking group : OK"
Write-Host "Vraies reservations enfants : OK"
Write-Host "Prix total distribue : OK"
Write-Host "Acceptation prestataire groupee : OK"
Write-Host "Paiement enfant individuel : BLOQUE"
Write-Host "Statut enfant individuel : BLOQUE"
Write-Host ""
