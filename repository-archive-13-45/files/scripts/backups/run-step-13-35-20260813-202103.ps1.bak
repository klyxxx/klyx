$ErrorActionPreference = "Stop"

$utf8 =
    New-Object System.Text.UTF8Encoding($false)

$root =
    Split-Path -Parent $PSScriptRoot

$remoteDump =
    Join-Path `
        $root `
        "reports\13-34-remote-schema\public-schema.sql"

$baseline =
    Join-Path `
        $root `
        "supabase\baseline-staging-13-34\20260814000000_klyx_public_baseline_13_34.sql"

$workRoot =
    Join-Path `
        $root `
        ".klyx-fidelity-rebuild-13-35"

$workMigrations =
    Join-Path `
        $workRoot `
        "supabase\migrations"

$localDump =
    Join-Path `
        $root `
        "reports\13-35-local-public-schema.sql"

$jsonReport =
    Join-Path `
        $root `
        "reports\supabase-baseline-fidelity-13-35.json"

$textReport =
    Join-Path `
        $root `
        "reports\supabase-baseline-fidelity-13-35.txt"

# KLYX_BASELINE_FIDELITY_AUDIT_13_35

foreach (
    $required
    in @(
        $remoteDump,
        $baseline
    )
) {
    if (
        -not (
            Test-Path `
                -LiteralPath `
                $required
        )
    ) {
        throw (
            "13.35 : fichier requis introuvable : " +
            $required
        )
    }
}

if (
    Test-Path `
        -LiteralPath `
        $workRoot
) {
    Remove-Item `
        -LiteralPath `
        $workRoot `
        -Recurse `
        -Force
}

New-Item `
    -ItemType Directory `
    -Force `
    -Path $workRoot |
    Out-Null

Push-Location $workRoot

try {
    cmd.exe /d /s /c `
        "npx.cmd supabase init 2>&1"

    $initExit =
        $LASTEXITCODE

    if (
        $initExit -ne 0
    ) {
        throw (
            "13.35 : supabase init FAILED. ExitCode=" +
            $initExit
        )
    }
}
finally {
    Pop-Location
}

New-Item `
    -ItemType Directory `
    -Force `
    -Path $workMigrations |
    Out-Null

Copy-Item `
    -LiteralPath `
    $baseline `
    -Destination (
        Join-Path `
            $workMigrations `
            "20260814000000_klyx_public_baseline_13_34.sql"
    ) `
    -Force

$started =
    $false

Push-Location $workRoot

try {
    Write-Host ""
    Write-Host "Starting disposable Supabase..."
    Write-Host ""

    $startOutput =
        @(
            cmd.exe /d /s /c `
                "npx.cmd supabase start 2>&1"
        )

    $startExit =
        $LASTEXITCODE

    foreach (
        $line
        in $startOutput
    ) {
        Write-Host $line
    }

    if (
        $startExit -ne 0
    ) {
        throw (
            "13.35 : local Supabase start FAILED. ExitCode=" +
            $startExit
        )
    }

    $started =
        $true

    Write-Host ""
    Write-Host "Dumping reconstructed local schema..."
    Write-Host ""

    cmd.exe /d /s /c `
        (
            'npx.cmd supabase db dump ' +
            '--local ' +
            '--schema public ' +
            '--file "' +
            $localDump +
            '" 2>&1'
        )

    $dumpExit =
        $LASTEXITCODE

    if (
        $dumpExit -ne 0
    ) {
        throw (
            "13.35 : local schema dump FAILED. ExitCode=" +
            $dumpExit
        )
    }
}
finally {
    if (
        $started
    ) {
        Write-Host ""
        Write-Host "Stopping disposable Supabase..."
        Write-Host ""

        cmd.exe /d /s /c `
            "npx.cmd supabase stop --no-backup >nul 2>&1" |
            Out-Null
    }

    Pop-Location
}

if (
    -not (
        Test-Path `
            -LiteralPath `
            $localDump
    )
) {
    throw "13.35 : dump local introuvable."
}

$remote =
    [System.IO.File]::ReadAllText(
        $remoteDump
    )

$local =
    [System.IO.File]::ReadAllText(
        $localDump
    )

function Get-ObjectNames {
    param(
        [string]$Sql,
        [string]$Pattern
    )

    $values =
        New-Object System.Collections.Generic.List[string]

    $matches =
        [regex]::Matches(
            $Sql,
            $Pattern
        )

    foreach (
        $match
        in $matches
    ) {
        $value =
            $match.Groups[1].Value
                .ToLowerInvariant()

        if (
            -not $values.Contains(
                $value
            )
        ) {
            $values.Add(
                $value
            )
        }
    }

    return @(
        $values |
        Sort-Object
    )
}

$categories =
    @(
        [pscustomobject]@{
            Name = "tables"
            Pattern = '(?im)\bCREATE\s+TABLE(?:\s+IF\s+NOT\s+EXISTS)?\s+"public"\."([^"]+)"'
        },
        [pscustomobject]@{
            Name = "views"
            Pattern = '(?im)\bCREATE\s+(?:OR\s+REPLACE\s+)?VIEW\s+"public"\."([^"]+)"'
        },
        [pscustomobject]@{
            Name = "functions"
            Pattern = '(?im)\bCREATE\s+(?:OR\s+REPLACE\s+)?FUNCTION\s+"public"\."([^"]+)"'
        },
        [pscustomobject]@{
            Name = "indexes"
            Pattern = '(?im)\bCREATE\s+(?:UNIQUE\s+)?INDEX\s+"([^"]+)"'
        },
        [pscustomobject]@{
            Name = "policies"
            Pattern = '(?im)\bCREATE\s+POLICY\s+"([^"]+)"'
        },
        [pscustomobject]@{
            Name = "triggers"
            Pattern = '(?im)\bCREATE\s+(?:OR\s+REPLACE\s+)?TRIGGER\s+"([^"]+)"'
        },
        [pscustomobject]@{
            Name = "types"
            Pattern = '(?im)\bCREATE\s+TYPE\s+"public"\."([^"]+)"'
        }
    )

$comparisons =
    @()

$allEqual =
    $true

foreach (
    $category
    in $categories
) {
    $remoteNames =
        @(
            Get-ObjectNames `
                -Sql $remote `
                -Pattern $category.Pattern
        )

    $localNames =
        @(
            Get-ObjectNames `
                -Sql $local `
                -Pattern $category.Pattern
        )

    $missingLocal =
        @(
            $remoteNames |
            Where-Object {
                $_ -notin
                $localNames
            }
        )

    $extraLocal =
        @(
            $localNames |
            Where-Object {
                $_ -notin
                $remoteNames
            }
        )

    $equal =
        (
            $missingLocal.Count -eq 0 -and
            $extraLocal.Count -eq 0
        )

    if (
        -not $equal
    ) {
        $allEqual =
            $false
    }

    $comparisons +=
        [pscustomobject]@{
            Category =
                $category.Name

            RemoteCount =
                $remoteNames.Count

            LocalCount =
                $localNames.Count

            Equal =
                $equal

            MissingLocally =
                $missingLocal

            ExtraLocally =
                $extraLocal
        }
}

$requiredTables =
    @(
        "profiles",
        "services",
        "service_profiles",
        "user_services",
        "bookings",
        "booking_groups",
        "split_booking_batches",
        "split_booking_payment_runs",
        "split_booking_payment_units"
    )

$localTables =
    @(
        Get-ObjectNames `
            -Sql $local `
            -Pattern '(?im)\bCREATE\s+TABLE(?:\s+IF\s+NOT\s+EXISTS)?\s+"public"\."([^"]+)"'
    )

$missingCritical =
    @(
        $requiredTables |
        Where-Object {
            $_ -notin
            $localTables
        }
    )

$criticalPresent =
    (
        $missingCritical.Count -eq
        0
    )

$remoteHash =
    (
        Get-FileHash `
            -LiteralPath `
            $remoteDump `
            -Algorithm SHA256
    ).Hash.ToLowerInvariant()

$localHash =
    (
        Get-FileHash `
            -LiteralPath `
            $localDump `
            -Algorithm SHA256
    ).Hash.ToLowerInvariant()

$result =
    [pscustomobject]@{
        Step =
            "13.35"

        GeneratedAt =
            (
                Get-Date
            ).ToString(
                "o"
            )

        ObjectInventoriesEqual =
            $allEqual

        CriticalTablesPresent =
            $criticalPresent

        MissingCriticalTables =
            $missingCritical

        Comparisons =
            $comparisons

        RemoteDumpSha256 =
            $remoteHash

        LocalDumpSha256 =
            $localHash

        RawDumpHashesEqual =
            (
                $remoteHash -eq
                $localHash
            )

        ProductionDatabaseModified =
            $false

        LinkedWriteUsed =
            $false

        OfficialMigrationsModified =
            $false
    }

[System.IO.File]::WriteAllText(
    $jsonReport,
    (
        $result |
        ConvertTo-Json -Depth 100
    ),
    $utf8
)

$lines =
    New-Object System.Collections.Generic.List[string]

$lines.Add(
    "======================================"
)

$lines.Add(
    "KLYX 13.35 - BASELINE FIDELITY AUDIT"
)

$lines.Add(
    "======================================"
)

$lines.Add(
    ""
)

foreach (
    $comparison
    in $comparisons
) {
    $lines.Add(
        $comparison.Category +
        " | remote=" +
        $comparison.RemoteCount +
        " | local=" +
        $comparison.LocalCount +
        " | equal=" +
        $comparison.Equal
    )

    if (
        @(
            $comparison.MissingLocally
        ).Count -gt 0
    ) {
        $lines.Add(
            "  Missing locally: " +
            (
                @(
                    $comparison.MissingLocally
                ) -join ", "
            )
        )
    }

    if (
        @(
            $comparison.ExtraLocally
        ).Count -gt 0
    ) {
        $lines.Add(
            "  Extra locally: " +
            (
                @(
                    $comparison.ExtraLocally
                ) -join ", "
            )
        )
    }
}

$lines.Add(
    ""
)

$lines.Add(
    "Object inventories equal : " +
    $allEqual
)

$lines.Add(
    "Critical tables present : " +
    $criticalPresent
)

$lines.Add(
    "Raw dump hashes equal : " +
    $result.RawDumpHashesEqual
)

$lines.Add(
    ""
)

$lines.Add(
    "Production DB modified : NON"
)

$lines.Add(
    "Linked write used : NON"
)

$lines.Add(
    "Official migrations modified : NON"
)

$lines.Add(
    ""
)

$lines.Add(
    "======================================"
)

[System.IO.File]::WriteAllLines(
    $textReport,
    $lines,
    $utf8
)

if (
    -not $criticalPresent
) {
    throw (
        "13.35 : tables critiques manquantes : " +
        (
            $missingCritical -join ", "
        )
    )
}

if (
    -not $allEqual
) {
    throw "13.35 : divergence d'inventaire entre production et baseline locale."
}

Write-Host ""
Write-Host "======================================"
Write-Host "KLYX 13.35 FIDELITY OK"
Write-Host "======================================"
Write-Host "Tables : MATCH"
Write-Host "Views : MATCH"
Write-Host "Functions : MATCH"
Write-Host "Indexes : MATCH"
Write-Host "Policies : MATCH"
Write-Host "Triggers : MATCH"
Write-Host "Types : MATCH"
Write-Host "Critical tables : PRESENTES"
Write-Host "Production DB : NON TOUCHEE"
Write-Host "======================================"