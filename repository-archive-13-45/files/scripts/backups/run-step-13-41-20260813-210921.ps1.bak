$ErrorActionPreference = "Stop"

$utf8 =
    New-Object System.Text.UTF8Encoding($false)

$root =
    Split-Path -Parent $PSScriptRoot

Set-Location $root

$baselineVersion =
    "20260814000000"

$archiveDir =
    Join-Path `
        $root `
        "supabase\migration-history-archive-13-37\previous-official"

$preSchema =
    Join-Path `
        $root `
        "reports\13-40-pre-repair-snapshot\remote-public-schema.sql"

$postRoot =
    Join-Path `
        $root `
        "reports\13-41-post-repair"

$beforeSchema =
    Join-Path `
        $postRoot `
        "remote-public-schema-before-13-41c.sql"

$afterSchema =
    Join-Path `
        $postRoot `
        "remote-public-schema-after-13-41c.sql"

$beforeHistory =
    Join-Path `
        $postRoot `
        "remote-migration-history-before-13-41c.txt"

$afterHistory =
    Join-Path `
        $postRoot `
        "remote-migration-history-after-13-41c.txt"

$manifestPath =
    Join-Path `
        $root `
        "reports\supabase-history-repair-13-41.json"

$reportPath =
    Join-Path `
        $root `
        "reports\supabase-history-repair-13-41.txt"

# ============================================================
# REQUIRED INPUTS
# ============================================================

foreach (
    $required
    in @(
        $archiveDir,
        $preSchema
    )
) {
    if (
        -not (
            Test-Path `
                -LiteralPath `
                $required
        )
    ) {
        throw (
            "13.41c : requis introuvable : " +
            $required
        )
    }
}

New-Item `
    -ItemType Directory `
    -Force `
    -Path $postRoot |
    Out-Null

# ============================================================
# PARSER
# Supports ASCII "|" and Unicode U+2502 without embedding
# the Unicode character directly in the source.
# ============================================================

function Get-RemoteMigrationVersions {
    param(
        [string[]]$Lines
    )

    $versions =
        New-Object System.Collections.Generic.List[string]

    $tableDetected =
        $false

    foreach (
        $line
        in $Lines
    ) {
        $text =
            [string]$line

        $normalized =
            $text.Replace(
                [char]0x2502,
                [char]0x007C
            )

        if (
            $normalized -match
            '(?i)\bLOCAL\b.*\bREMOTE\b'
        ) {
            $tableDetected =
                $true

            continue
        }

        if (
            -not $normalized.Contains("|")
        ) {
            continue
        }

        $parts =
            $normalized.Split(
                [char]0x007C
            )

        if (
            $parts.Count -lt 2
        ) {
            continue
        }

        $localColumn =
            $parts[0].Trim()

        $remoteColumn =
            $parts[1].Trim()

        if (
            $localColumn -match '^\d{14}$' -or
            $remoteColumn -match '^\d{14}$'
        ) {
            $tableDetected =
                $true
        }

        if (
            $remoteColumn -match
            '^\d{14}$'
        ) {
            if (
                -not $versions.Contains(
                    $remoteColumn
                )
            ) {
                $versions.Add(
                    $remoteColumn
                )
            }
        }
    }

    if (
        -not $tableDetected
    ) {
        throw (
            "13.41c : format de migration list " +
            "Supabase non reconnu."
        )
    }

    return @(
        $versions |
        Sort-Object
    )
}

# ============================================================
# ARCHIVED VERSIONS
# ============================================================

$archiveFiles =
    @(
        Get-ChildItem `
            -LiteralPath `
            $archiveDir `
            -File `
            -Filter "*.sql" |
        Sort-Object Name
    )

$archiveVersions =
    New-Object System.Collections.Generic.List[string]

foreach (
    $file
    in $archiveFiles
) {
    $hit =
        [regex]::Match(
            $file.Name,
            '^(\d{14})'
        )

    if (
        $hit.Success
    ) {
        $version =
            $hit.Groups[1].Value

        if (
            -not $archiveVersions.Contains(
                $version
            )
        ) {
            $archiveVersions.Add(
                $version
            )
        }
    }
}

if (
    $archiveVersions.Count -lt 1
) {
    throw "13.41c : archive migrations vide."
}

# ============================================================
# VERIFY PRODUCTION SCHEMA BEFORE ANY NEW REPAIR
# ============================================================

$referenceSchemaHash =
    (
        Get-FileHash `
            -LiteralPath `
            $preSchema `
            -Algorithm SHA256
    ).Hash.ToLowerInvariant()

Write-Host ""
Write-Host "13.41c - Snapshot schema production avant reconciliation..."
Write-Host ""

$dumpBeforeCommand =
    'npx.cmd supabase db dump --linked --schema public --file "' +
    $beforeSchema +
    '" 2>&1'

$dumpBeforeOutput =
    @(
        cmd.exe /d /s /c $dumpBeforeCommand
    )

$dumpBeforeExit =
    $LASTEXITCODE

foreach (
    $line
    in $dumpBeforeOutput
) {
    Write-Host $line
}

if (
    $dumpBeforeExit -ne 0
) {
    throw (
        "13.41c : db dump avant FAILED. ExitCode=" +
        $dumpBeforeExit
    )
}

if (
    -not (
        Test-Path `
            -LiteralPath `
            $beforeSchema
    )
) {
    throw "13.41c : dump schema avant absent."
}

$beforeSchemaHash =
    (
        Get-FileHash `
            -LiteralPath `
            $beforeSchema `
            -Algorithm SHA256
    ).Hash.ToLowerInvariant()

if (
    $beforeSchemaHash -ne
    $referenceSchemaHash
) {
    throw (
        "13.41c : schema production differe du snapshot 13.40. " +
        "Aucune nouvelle ecriture migration executee."
    )
}

# ============================================================
# READ TRUE REMOTE HISTORY
# ============================================================

Write-Host ""
Write-Host "13.41c - Lecture historique distant reel..."
Write-Host ""

$beforeOutput =
    @(
        cmd.exe /d /s /c `
            "npx.cmd supabase migration list --linked 2>&1"
    )

$beforeExit =
    $LASTEXITCODE

foreach (
    $line
    in $beforeOutput
) {
    Write-Host $line
}

if (
    $beforeExit -ne 0
) {
    throw (
        "13.41c : migration list avant FAILED. ExitCode=" +
        $beforeExit
    )
}

[System.IO.File]::WriteAllLines(
    $beforeHistory,
    @(
        $beforeOutput |
        ForEach-Object {
            [string]$_
        }
    ),
    $utf8
)

$remoteBefore =
    @(
        Get-RemoteMigrationVersions `
            -Lines $beforeOutput
    )

Write-Host ""
Write-Host (
    "Remote versions detectees avant : " +
    $remoteBefore.Count
)

foreach (
    $version
    in $remoteBefore
) {
    Write-Host (
        "REMOTE BEFORE -> " +
        $version
    )
}

# ============================================================
# CLASSIFY CURRENT REMOTE STATE
# ============================================================

$unknownRemote =
    @(
        $remoteBefore |
        Where-Object {
            $_ -ne $baselineVersion -and
            $_ -notin $archiveVersions
        } |
        Sort-Object -Unique
    )

if (
    $unknownRemote.Count -gt 0
) {
    Write-Host ""
    Write-Host "Versions distantes inconnues :"

    foreach (
        $version
        in $unknownRemote
    ) {
        Write-Host (
            "UNKNOWN -> " +
            $version
        )
    }

    throw (
        "13.41c : migrations distantes inconnues. " +
        "Reconciliation bloquee."
    )
}

$remainingHistorical =
    @(
        $remoteBefore |
        Where-Object {
            $_ -ne $baselineVersion -and
            $_ -in $archiveVersions
        } |
        Sort-Object -Unique
    )

$baselinePresentBefore =
    (
        $baselineVersion -in
        $remoteBefore
    )

# ============================================================
# FINISH ONLY WHAT IS STILL NECESSARY
# ============================================================

$revertedNow =
    New-Object System.Collections.Generic.List[string]

foreach (
    $version
    in $remainingHistorical
) {
    Write-Host ""
    Write-Host (
        "Reverting remaining historical record : " +
        $version
    )

    $command =
        "npx.cmd supabase migration repair " +
        $version +
        " --status reverted --linked 2>&1"

    $repairOutput =
        @(
            cmd.exe /d /s /c $command
        )

    $repairExit =
        $LASTEXITCODE

    foreach (
        $line
        in $repairOutput
    ) {
        Write-Host $line
    }

    if (
        $repairExit -ne 0
    ) {
        throw (
            "13.41c : reverted FAILED pour " +
            $version +
            ". ExitCode=" +
            $repairExit
        )
    }

    $revertedNow.Add(
        $version
    )
}

$baselineAppliedNow =
    $false

if (
    -not $baselinePresentBefore
) {
    Write-Host ""
    Write-Host (
        "Applying canonical history record : " +
        $baselineVersion
    )

    $command =
        "npx.cmd supabase migration repair " +
        $baselineVersion +
        " --status applied --linked 2>&1"

    $applyOutput =
        @(
            cmd.exe /d /s /c $command
        )

    $applyExit =
        $LASTEXITCODE

    foreach (
        $line
        in $applyOutput
    ) {
        Write-Host $line
    }

    if (
        $applyExit -ne 0
    ) {
        throw (
            "13.41c : baseline applied FAILED. ExitCode=" +
            $applyExit
        )
    }

    $baselineAppliedNow =
        $true
}

# ============================================================
# VERIFY TRUE REMOTE HISTORY AFTER
# ============================================================

Write-Host ""
Write-Host "13.41c - Verification historique distant final..."
Write-Host ""

$afterOutput =
    @(
        cmd.exe /d /s /c `
            "npx.cmd supabase migration list --linked 2>&1"
    )

$afterExit =
    $LASTEXITCODE

foreach (
    $line
    in $afterOutput
) {
    Write-Host $line
}

if (
    $afterExit -ne 0
) {
    throw (
        "13.41c : migration list final FAILED. ExitCode=" +
        $afterExit
    )
}

[System.IO.File]::WriteAllLines(
    $afterHistory,
    @(
        $afterOutput |
        ForEach-Object {
            [string]$_
        }
    ),
    $utf8
)

$remoteAfter =
    @(
        Get-RemoteMigrationVersions `
            -Lines $afterOutput
    )

Write-Host ""
Write-Host (
    "Remote versions detectees apres : " +
    $remoteAfter.Count
)

foreach (
    $version
    in $remoteAfter
) {
    Write-Host (
        "REMOTE AFTER -> " +
        $version
    )
}

if (
    $remoteAfter.Count -ne 1
) {
    throw (
        "13.41c : historique REMOTE attendu=1, trouve=" +
        $remoteAfter.Count +
        " [" +
        (
            $remoteAfter -join ", "
        ) +
        "]"
    )
}

if (
    $remoteAfter[0] -ne
    $baselineVersion
) {
    throw (
        "13.41c : baseline distante finale incorrecte : " +
        $remoteAfter[0]
    )
}

# ============================================================
# VERIFY PRODUCTION SCHEMA AFTER
# ============================================================

Write-Host ""
Write-Host "13.41c - Verification schema production apres..."
Write-Host ""

$dumpAfterCommand =
    'npx.cmd supabase db dump --linked --schema public --file "' +
    $afterSchema +
    '" 2>&1'

$dumpAfterOutput =
    @(
        cmd.exe /d /s /c $dumpAfterCommand
    )

$dumpAfterExit =
    $LASTEXITCODE

foreach (
    $line
    in $dumpAfterOutput
) {
    Write-Host $line
}

if (
    $dumpAfterExit -ne 0
) {
    throw (
        "13.41c : db dump final FAILED. ExitCode=" +
        $dumpAfterExit
    )
}

$afterSchemaHash =
    (
        Get-FileHash `
            -LiteralPath `
            $afterSchema `
            -Algorithm SHA256
    ).Hash.ToLowerInvariant()

$schemaUnchanged =
    (
        $afterSchemaHash -eq
        $referenceSchemaHash
    )

if (
    -not $schemaUnchanged
) {
    throw (
        "13.41c : schema production modifie. STOP."
    )
}

# ============================================================
# MANIFEST
# ============================================================

$result =
    [pscustomobject]@{
        Step =
            "13.41c"

        GeneratedAt =
            (
                Get-Date
            ).ToString(
                "o"
            )

        ParserRebuilt =
            $true

        UnicodeSeparatorSupported =
            $true

        AsciiSeparatorSupported =
            $true

        CanonicalBaselineVersion =
            $baselineVersion

        RemoteVersionsBefore =
            $remoteBefore

        RemoteVersionsAfter =
            $remoteAfter

        RemoteCountBefore =
            $remoteBefore.Count

        RemoteCountAfter =
            $remoteAfter.Count

        UnknownRemoteVersions =
            $unknownRemote

        RemainingHistoricalBefore =
            $remainingHistorical

        HistoricalVersionsRevertedNow =
            @(
                $revertedNow
            )

        BaselinePresentBefore =
            $baselinePresentBefore

        BaselineAppliedNow =
            $baselineAppliedNow

        RemoteHistoryCanonical =
            $true

        ReferenceSchemaSha256 =
            $referenceSchemaHash

        BeforeSchemaSha256 =
            $beforeSchemaHash

        AfterSchemaSha256 =
            $afterSchemaHash

        ProductionSchemaUnchanged =
            $schemaUnchanged

        ApplicationSchemaModified =
            $false

        ApplicationDataModified =
            $false

        DbPushLinkedUsed =
            $false

        DbResetLinkedUsed =
            $false

        MigrationUpLinkedUsed =
            $false

        RepairCompleted =
            $true
    }

[System.IO.File]::WriteAllText(
    $manifestPath,
    (
        $result |
        ConvertTo-Json -Depth 100
    ),
    $utf8
)

# ============================================================
# REPORT
# ============================================================

$report =
    @(
        "======================================",
        "KLYX 13.41c - REMOTE HISTORY RECONCILIATION",
        "======================================",
        "",
        "Parser rebuilt : OUI",
        "ASCII separator supported : OUI",
        "Unicode separator supported : OUI",
        (
            "Remote versions before : " +
            $remoteBefore.Count
        ),
        (
            "Historical records reverted now : " +
            $revertedNow.Count
        ),
        (
            "Baseline applied now : " +
            $baselineAppliedNow
        ),
        (
            "Remote versions after : " +
            $remoteAfter.Count
        ),
        (
            "Canonical remote baseline : " +
            $remoteAfter[0]
        ),
        "",
        "Remote migration history canonical : OUI",
        "Production public schema unchanged : OUI",
        "Application schema modified : NON",
        "Application data modified : NON",
        "db push --linked : NON",
        "db reset --linked : NON",
        "migration up --linked : NON",
        "",
        "======================================"
    )

[System.IO.File]::WriteAllLines(
    $reportPath,
    $report,
    $utf8
)

Write-Host ""
Write-Host "======================================"
Write-Host "KLYX 13.41c HISTORY RECONCILIATION OK"
Write-Host "======================================"
Write-Host "Migration parser : REBUILT"
Write-Host "Remote migration count : 1"
Write-Host (
    "Canonical remote baseline : " +
    $baselineVersion
)
Write-Host "Production public schema : UNCHANGED"
Write-Host "Application data : UNCHANGED"
Write-Host "db push --linked : NON"
Write-Host "db reset --linked : NON"
Write-Host "======================================"