$ErrorActionPreference = "Stop"

$root =
    Split-Path -Parent $PSScriptRoot

Set-Location $root

$runner =
    Join-Path `
        $root `
        "scripts\run-step-13-41-controlled-history-repair.ps1"

$manifestPath =
    Join-Path `
        $root `
        "reports\supabase-history-repair-13-41.json"

Write-Host ""
Write-Host "KLYX 13.41c remote history reconciliation..."
Write-Host ""

powershell `
    -ExecutionPolicy Bypass `
    -File $runner

if (
    $LASTEXITCODE -ne 0
) {
    throw "KLYX 13.41c runner FAILED."
}

if (
    -not (
        Test-Path `
            -LiteralPath `
            $manifestPath
    )
) {
    throw "13.41c : manifest introuvable."
}

$data =
    Get-Content `
        -LiteralPath `
        $manifestPath `
        -Raw |
    ConvertFrom-Json

if (
    $data.ParserRebuilt -ne
    $true
) {
    throw "13.41c : parser invalide."
}

if (
    $data.RemoteHistoryCanonical -ne
    $true
) {
    throw "13.41c : historique distant non canonique."
}

if (
    [int]$data.RemoteCountAfter -ne
    1
) {
    throw "13.41c : nombre migrations distant != 1."
}

if (
    @(
        $data.UnknownRemoteVersions
    ).Count -gt 0
) {
    throw "13.41c : versions distantes inconnues."
}

if (
    $data.ProductionSchemaUnchanged -ne
    $true
) {
    throw "13.41c : schema production modifie."
}

if (
    $data.ApplicationSchemaModified -ne
    $false
) {
    throw "13.41c : schema applicatif modifie."
}

if (
    $data.ApplicationDataModified -ne
    $false
) {
    throw "13.41c : donnees applicatives modifiees."
}

if (
    $data.DbPushLinkedUsed -ne
    $false
) {
    throw "13.41c : db push linked interdit."
}

if (
    $data.DbResetLinkedUsed -ne
    $false
) {
    throw "13.41c : db reset linked interdit."
}

Write-Host ""
Write-Host "Automated tests..."
Write-Host ""

npm.cmd test

if (
    $LASTEXITCODE -ne 0
) {
    throw "KLYX 13.41c tests FAILED."
}

Write-Host ""
Write-Host "TypeScript..."
Write-Host ""

npx.cmd tsc --noEmit --pretty false

if (
    $LASTEXITCODE -ne 0
) {
    throw "KLYX 13.41c TypeScript FAILED."
}

Write-Host ""
Write-Host "Next build..."
Write-Host ""

npm.cmd run build

if (
    $LASTEXITCODE -ne 0
) {
    throw "KLYX 13.41c build FAILED."
}

Write-Host ""
Write-Host "======================================"
Write-Host "KLYX 13.41 CHECK OK"
Write-Host "======================================"
Write-Host "Migration parser : REBUILT"
Write-Host "Remote migration history : CANONICAL"
Write-Host "Canonical baseline remote : APPLIED"
Write-Host "Remote migration count : 1"
Write-Host "Production public schema : UNCHANGED"
Write-Host "Application data : UNCHANGED"
Write-Host "db push --linked : NON"
Write-Host "db reset --linked : NON"
Write-Host "Automated tests : OK"
Write-Host "TypeScript : OK"
Write-Host "Build Next.js : OK"
Write-Host "======================================"