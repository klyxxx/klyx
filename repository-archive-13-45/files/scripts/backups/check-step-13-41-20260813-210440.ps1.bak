$ErrorActionPreference = "Stop"

$root =
    Split-Path -Parent $PSScriptRoot

Set-Location $root

$runner =
    Join-Path `
        $root `
        "scripts\run-step-13-41-controlled-history-repair.ps1"

$manifestPath =
    Join-Path `
        $root `
        "reports\supabase-history-repair-13-41.json"

Write-Host ""
Write-Host "KLYX 13.41a remote history reconciliation..."
Write-Host ""

powershell `
    -ExecutionPolicy Bypass `
    -File $runner

if (
    $LASTEXITCODE -ne 0
) {
    throw "KLYX 13.41a runner FAILED."
}

$data =
    Get-Content `
        -LiteralPath `
        $manifestPath `
        -Raw |
    ConvertFrom-Json

if (
    $data.ParserFixed -ne
    $true
) {
    throw "13.41a : parser non corrige."
}

if (
    $data.ParsedRemoteColumnOnly -ne
    $true
) {
    throw "13.41a : colonne remote non isolee."
}

if (
    $data.RemoteHistoryCanonical -ne
    $true
) {
    throw "13.41a : historique distant non canonique."
}

if (
    @(
        $data.TrueRemoteVersionsAfter
    ).Count -ne 1
) {
    throw "13.41a : historique distant final != 1."
}

if (
    $data.ProductionSchemaUnchanged -ne
    $true
) {
    throw "13.41a : schema production modifie."
}

if (
    $data.ApplicationSchemaModified -ne
    $false
) {
    throw "13.41a : schema applicatif modifie."
}

if (
    $data.ApplicationDataModified -ne
    $false
) {
    throw "13.41a : donnees applicatives modifiees."
}

if (
    $data.DbPushLinkedUsed -ne
    $false
) {
    throw "13.41a : db push linked interdit."
}

if (
    $data.DbResetLinkedUsed -ne
    $false
) {
    throw "13.41a : db reset linked interdit."
}

Write-Host ""
Write-Host "Automated tests..."
Write-Host ""

npm.cmd test

if (
    $LASTEXITCODE -ne 0
) {
    throw "KLYX 13.41a tests FAILED."
}

Write-Host ""
Write-Host "TypeScript..."
Write-Host ""

npx.cmd tsc --noEmit --pretty false

if (
    $LASTEXITCODE -ne 0
) {
    throw "KLYX 13.41a TypeScript FAILED."
}

Write-Host ""
Write-Host "Next build..."
Write-Host ""

npm.cmd run build

if (
    $LASTEXITCODE -ne 0
) {
    throw "KLYX 13.41a build FAILED."
}

Write-Host ""
Write-Host "======================================"
Write-Host "KLYX 13.41 CHECK OK"
Write-Host "======================================"
Write-Host "Migration parser : REMOTE COLUMN ONLY"
Write-Host "Remote migration history : CANONICAL"
Write-Host "Canonical baseline remote : APPLIED"
Write-Host "Remote migration count : 1"
Write-Host "Production public schema : UNCHANGED"
Write-Host "Application data : UNCHANGED"
Write-Host "db push --linked : NON"
Write-Host "db reset --linked : NON"
Write-Host "Automated tests : OK"
Write-Host "TypeScript : OK"
Write-Host "Build Next.js : OK"
Write-Host "======================================"