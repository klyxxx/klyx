# KLYX_SPLIT_BOOKING_FIX_13_19B
$ErrorActionPreference = "Stop"

$root = Split-Path -Parent $PSScriptRoot
$utf8 = New-Object System.Text.UTF8Encoding($false)

function Decode([string]$Value) {
    return [System.Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($Value))
}

$sql = Decode ""
$route = Decode ""
$component = Decode ""

$migration18 = $null
$migrationPath = Join-Path $root "supabase\migrations\20260813133700_klyx_split_booking_batch_13_19.sql"

$confirmationRoute = Join-Path $root "app\api\market\requests\[id]\split-fallback\confirm\route.ts"
$bookingCreateRoute = Join-Path $root "app\api\bookings\create\route.ts"
$reviewPath = Join-Path $root "app\assistant\market\[id]\split-plan\page.tsx"

$routeDir = Join-Path $root "app\api\market\requests\[id]\split-fallback\book"
$routePath = Join-Path $routeDir "route.ts"

$componentPath = Join-Path $root "app\assistant\market\[id]\split-plan\SplitPlanBookingAction.tsx"

foreach ($path in @($confirmationRoute, $bookingCreateRoute, $reviewPath)) {
    if (-not (Test-Path -LiteralPath $path)) {
        throw "13.19 : fichier requis introuvable : $path"
    }
}

$confirmation = [System.IO.File]::ReadAllText($confirmationRoute)
$bookingCreate = [System.IO.File]::ReadAllText($bookingCreateRoute)
$review = [System.IO.File]::ReadAllText($reviewPath)
$migration18Text = ""

$migrationDirectory =
    Join-Path $root "supabase\migrations"

if (Test-Path -LiteralPath $migrationDirectory) {
    $migration18Candidate =
        Get-ChildItem `
            -LiteralPath $migrationDirectory `
            -Filter "*.sql" `
            -File `
            -ErrorAction SilentlyContinue |
        Where-Object {
            $sql =
                [System.IO.File]::ReadAllText(
                    $_.FullName
                )

            $sql.Contains(
                "KLYX_SPLIT_PLAN_CONFIRMATION_PROOF_13_18"
            ) -or
            $sql.Contains(
                "klyx_confirm_split_plan_13_18"
            ) -or
            $sql.Contains(
                "market_split_plan_confirmations"
            )
        } |
        Select-Object -First 1

    if ($migration18Candidate) {
        $migration18 =
            $migration18Candidate.FullName

        $migration18Text =
            [System.IO.File]::ReadAllText(
                $migration18
            )

        Write-Host (
            "13.18 migration detectee : " +
            $migration18
        )
    }
    else {
        Write-Host (
            "13.18 migration locale non trouvee : " +
            "validation par API 13.18 + Supabase."
        )
    }
}

# KLYX_SPLIT_BOOKING_FIX_13_19D
# Le prerequis DB 13.18 est restaure par :
# 20260813133600_klyx_split_plan_confirmation_compat_13_19d.sql

if (-not $confirmation.Contains("KLYX_SPLIT_PLAN_CONFIRMATION_API_13_18")) {
    throw "13.19 : API 13.18 introuvable."
}

if (-not $review.Contains("KLYX_SPLIT_PLAN_CONFIRMATION_WIRING_13_18")) {
    throw "13.19 : UI 13.18 introuvable."
}

foreach ($needle in @("providerId", "serviceSlug", "bookingDate", "startTime", "endTime")) {
    if (-not $bookingCreate.Contains($needle)) {
        throw "13.19 : contrat /api/bookings/create incomplet : $needle"
    }
}

if ($review.Contains("KLYX_SPLIT_BOOKING_WIRING_13_19")) {
    Write-Host "KLYX 13.19 deja applique."
    exit 0
}

if (Test-Path -LiteralPath $migrationPath) {
    $existing = [System.IO.File]::ReadAllText($migrationPath)

    if (-not $existing.Contains("KLYX_SPLIT_BOOKING_BATCH_13_19")) {
        throw "13.19 : timestamp migration deja utilise."
    }
}

$confirmationRender = "<SplitPlanConfirmation"
$confirmationIndex = $review.IndexOf($confirmationRender)

if ($confirmationIndex -lt 0) {
    throw "13.19 : composant confirmation 13.18 introuvable."
}

$anchor = '            <section className="mt-7 rounded-[2rem] border border-blue-500/20 bg-blue-500/10 p-6 sm:p-8">'
$anchorIndex = $review.IndexOf($anchor)

if ($anchorIndex -lt 0) {
    throw "13.19 : anchor UI introuvable."
}

$firstImport = $review.IndexOf("import ")

if ($firstImport -lt 0) {
    throw "13.19 : imports page introuvables."
}

$timestamp = Get-Date -Format "yyyyMMdd-HHmmss"

Copy-Item -LiteralPath $reviewPath -Destination ($reviewPath + ".bak-13-19-" + $timestamp) -Force

if (Test-Path -LiteralPath $routePath) {
    Copy-Item -LiteralPath $routePath -Destination ($routePath + ".bak-13-19-" + $timestamp) -Force
}

if (Test-Path -LiteralPath $componentPath) {
    Copy-Item -LiteralPath $componentPath -Destination ($componentPath + ".bak-13-19-" + $timestamp) -Force
}

$import = 'import SplitPlanBookingAction from "./SplitPlanBookingAction";' + "`r`n"
$review = $review.Insert($firstImport, $import)

# Recalcule apres import.
$anchorIndex = $review.IndexOf($anchor)

if ($anchorIndex -lt 0) {
    throw "13.19 : anchor perdu apres import."
}

$render =
    "            {/* KLYX_SPLIT_BOOKING_WIRING_13_19 */}`r`n" +
    "            <SplitPlanBookingAction`r`n" +
    "              requestId={requestId}`r`n" +
    "            />`r`n`r`n"

$review = $review.Insert($anchorIndex, $render)

New-Item -ItemType Directory -Force -Path $routeDir | Out-Null

[System.IO.File]::WriteAllText($migrationPath, $sql, $utf8)
[System.IO.File]::WriteAllText($routePath, $route, $utf8)
[System.IO.File]::WriteAllText($componentPath, $component, $utf8)
[System.IO.File]::WriteAllText($reviewPath, $review, $utf8)

Write-Host ""
Write-Host "======================================"
Write-Host "KLYX 13.19 APPLIQUE"
Write-Host "======================================"
Write-Host "Preuve 13.18 : OBLIGATOIRE"
Write-Host "Autorisation booking : EXPLICITE"
Write-Host "1 slot confirme : 1 BOOKING"
Write-Host "Multi-provider : VRAIES RESERVATIONS"
Write-Host "Double clic : PROTEGE"
Write-Host "Echec partiel : COMPENSATION"
Write-Host "Retry automatique : NON"
Write-Host "Paiement automatique : NON"
Write-Host "Migration : 13.19"
Write-Host "======================================"
