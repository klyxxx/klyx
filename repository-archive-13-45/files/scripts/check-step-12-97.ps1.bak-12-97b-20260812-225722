$ErrorActionPreference = "Stop"

$root =
    Split-Path -Parent $PSScriptRoot

$routePath =
    Join-Path $root "app\api\market\requests\[id]\group-booking\route.ts"

$livePath =
    Join-Path $root "lib\multi-slot-live-coverage.ts"

$migrationDir =
    Join-Path $root "supabase\migrations"

foreach (
    $path in @(
        $routePath,
        $livePath
    )
) {
    if (
        -not (
            Test-Path -LiteralPath $path
        )
    ) {
        throw "Fichier absent : $path"
    }
}

$route =
    [System.IO.File]::ReadAllText(
        $routePath
    )

$live =
    [System.IO.File]::ReadAllText(
        $livePath
    )

$migration96 =
    Get-ChildItem `
        -LiteralPath $migrationDir `
        -File |
    Select-String `
        -Pattern "KLYX_GROUP_ATOMIC_LIVE_COVERAGE_12_96" `
        -SimpleMatch `
        -List

$checks = @(
    @{
        Name = "recovery 12.97"
        Value =
            $route.Contains(
                "KLYX_GROUP_STALE_PROVIDER_RECOVERY_12_97"
            )
    },
    @{
        Name = "legacy POST preserved"
        Value =
            $route.Contains(
                "klyxGroupBookingPostBeforeRecovery("
            )
    },
    @{
        Name = "exactly one exported POST"
        Value =
            (
                [regex]::Matches(
                    $route,
                    "export\s+async\s+function\s+POST\s*\("
                ).Count
            ) -eq 1
    },
    @{
        Name = "request cloned before legacy call"
        Value =
            $route.Contains(
                "request.clone()"
            )
    },
    @{
        Name = "12.96 error intercepted"
        Value =
            $route.Contains(
                "KLYX_GROUP_LIVE_COVERAGE_REQUIRED"
            )
    },
    @{
        Name = "12.96 coverage RPC reused"
        Value =
            $route.Contains(
                "klyx_group_live_coverage_check"
            )
    },
    @{
        Name = "client ownership rechecked"
        Value =
            $route.Contains(
                "marketRequest.client_profile_id"
            ) -and
            $route.Contains(
                "profile.id"
            )
    },
    @{
        Name = "offer ownership relation checked"
        Value =
            $route.Contains(
                '"request_id"'
            ) -and
            $route.Contains(
                "offerId"
            )
    },
    @{
        Name = "candidate resynchronized"
        Value =
            $route.Contains(
                "market_request_provider_candidates"
            ) -and
            $route.Contains(
                "coverage_count:"
            ) -and
            $route.Contains(
                "full_coverage:"
            )
    },
    @{
        Name = "candidate becomes non full"
        Value =
            $route.Contains(
                "full_coverage:" + [Environment]::NewLine + "          false"
            ) -or
            $route.Contains(
                "full_coverage:`r`n          false"
            ) -or
            $route.Contains(
                "full_coverage:`n          false"
            )
    },
    @{
        Name = "offer not auto rejected"
        Value =
            $route.Contains(
                "L offre elle-meme reste intacte"
            )
    },
    @{
        Name = "clear recovery code"
        Value =
            $route.Contains(
                "GROUP_PROVIDER_AVAILABILITY_CHANGED"
            )
    },
    @{
        Name = "409 returned"
        Value =
            $route.Contains(
                "status: 409"
            )
    },
    @{
        Name = "no automatic booking"
        Value =
            $route.Contains(
                "automaticBooking:"
            ) -and
            $route.Contains(
                "false"
            )
    },
    @{
        Name = "no automatic payment"
        Value =
            $route.Contains(
                "automaticPayment:"
            ) -and
            $route.Contains(
                "false"
            )
    },
    @{
        Name = "12.95 retained"
        Value =
            $live.Contains(
                "KLYX_MULTI_SLOT_LIVE_COVERAGE_12_95"
            )
    },
    @{
        Name = "12.96 migration retained"
        Value =
            Boolean(
                $migration96
            )
    }
)

$failed = @()

Write-Host ""
Write-Host "CHECK KLYX 12.97"
Write-Host ""

foreach (
    $check in $checks
) {
    if (
        $check.Value
    ) {
        Write-Host "[OK]   $($check.Name)"
    }
    else {
        Write-Host "[FAIL] $($check.Name)"
        $failed +=
            $check.Name
    }
}

if (
    $failed.Count -gt 0
) {
    Write-Host ""
    Write-Host "ECHECS EXACTS :"

    foreach (
        $name in $failed
    ) {
        Write-Host " - $name"
    }

    throw "KLYX 12.97 static checker FAILED."
}

Push-Location $root

try {
    Write-Host ""
    Write-Host "TypeScript..."
    Write-Host ""

    $tsOutput = @(
        & npx.cmd `
            tsc `
            --noEmit `
            --pretty false 2>&1
    )

    if (
        $LASTEXITCODE -ne 0
    ) {
        $tsOutput |
            Select-Object -First 300 |
            ForEach-Object {
                Write-Host $_
            }

        throw "KLYX 12.97 TypeScript FAILED."
    }

    Write-Host "TypeScript OK."
    Write-Host ""
    Write-Host "npm run build..."
    Write-Host ""

    & npm.cmd run build

    if (
        $LASTEXITCODE -ne 0
    ) {
        throw "KLYX 12.97 build FAILED."
    }
}
finally {
    Pop-Location
}

Write-Host ""
Write-Host "======================================"
Write-Host "KLYX 12.97 CHECK OK"
Write-Host "======================================"
Write-Host "Blocage DB 12.96 : GERE"
Write-Host "Erreur client claire : OK"
Write-Host "Demande reste disponible : OK"
Write-Host "Prestataire stale : NON ELIGIBLE"
Write-Host "Candidat resynchronise : OK"
Write-Host "Offre auto-refusee : NON"
Write-Host "Booking groupe cree : NON"
Write-Host "Booking enfant cree : NON"
Write-Host "Paiement cree : NON"
Write-Host "Autre prestataire selectionnable : OUI"
Write-Host "Build Next.js : OK"
Write-Host "======================================"
Write-Host ""