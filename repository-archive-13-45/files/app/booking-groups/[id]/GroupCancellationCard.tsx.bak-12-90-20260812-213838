"use client";

import {
  FormEvent,
  useCallback,
  useEffect,
  useState,
} from "react";

import {
  AlertTriangle,
  CheckCircle2,
  LoaderCircle,
  RotateCcw,
  ShieldCheck,
  XCircle,
} from "lucide-react";

import {
  supabase,
} from "@/lib/supabase";

// KLYX_GROUP_CANCELLATION_UI_12_89

type Props = {
  groupId: string;
  groupStatus: string;
  paymentStatus: string;

  role:
    | "client"
    | "provider";
};

type CancellationResponse = {
  groupId?: string;

  role?:
    | "client"
    | "provider";

  groupStatus?: string;

  paymentStatus?: string;

  cancellationStatus?:
    | "none"
    | "requested"
    | "withdrawn"
    | "resolved";

  requestedBy?:
    | string
    | null;

  requestedRole?:
    | "client"
    | "provider"
    | null;

  reason?:
    | string
    | null;

  requestedAt?:
    | string
    | null;

  withdrawnAt?:
    | string
    | null;

  refundStatus?: string;

  isRequester?: boolean;
  canRequest?: boolean;
  canWithdraw?: boolean;

  automaticCancellation?:
    boolean;

  automaticRefund?:
    boolean;

  requiresFinancialResolution?:
    boolean;

  message?: string;
  error?: string;

  // KLYX_GROUP_CANCELLATION_TYPE_FIX_12_89B
  alreadyRequested?: boolean;
};

async function accessToken() {
  const {
    data: {
      session,
    },
  } =
    await supabase.auth.getSession();

  if (
    !session?.access_token
  ) {
    throw new Error(
      "Session manquante."
    );
  }

  return session.access_token;
}

async function parseResponse(
  response: Response
): Promise<CancellationResponse> {
  const body =
    (await response.json()) as
      CancellationResponse;

  if (
    !response.ok &&
    !body.alreadyRequested
  ) {
    throw new Error(
      body.error ||
        "Une erreur est survenue."
    );
  }

  return body;
}

export default function GroupCancellationCard(
  props: Props
) {
  const {
    groupId,
    groupStatus,
    paymentStatus,
  } = props;

  const [
    loading,
    setLoading,
  ] =
    useState(true);

  const [
    saving,
    setSaving,
  ] =
    useState(false);

  const [
    opened,
    setOpened,
  ] =
    useState(false);

  const [
    reason,
    setReason,
  ] =
    useState("");

  const [
    state,
    setState,
  ] =
    useState<CancellationResponse | null>(
      null
    );

  const [
    message,
    setMessage,
  ] =
    useState("");

  const [
    errorMessage,
    setErrorMessage,
  ] =
    useState("");

  const loadState =
    useCallback(
      async () => {
        setLoading(true);
        setErrorMessage("");

        try {
          const token =
            await accessToken();

          const response =
            await fetch(
              "/api/booking-groups/" +
                encodeURIComponent(
                  groupId
                ) +
                "/cancellation",
              {
                method:
                  "GET",

                cache:
                  "no-store",

                headers: {
                  Authorization:
                    "Bearer " +
                    token,
                },
              }
            );

          const body =
            await parseResponse(
              response
            );

          setState(
            body
          );
        } catch (error) {
          setErrorMessage(
            error instanceof Error
              ? error.message
              : "Chargement impossible."
          );
        } finally {
          setLoading(
            false
          );
        }
      },
      [
        groupId,
      ]
    );

  useEffect(() => {
    void loadState();
  }, [loadState]);

  async function requestCancellation(
    event:
      FormEvent<HTMLFormElement>
  ) {
    event.preventDefault();

    setSaving(true);
    setMessage("");
    setErrorMessage("");

    try {
      const token =
        await accessToken();

      const response =
        await fetch(
          "/api/booking-groups/" +
            encodeURIComponent(
              groupId
            ) +
            "/cancellation",
          {
            method:
              "POST",

            headers: {
              "Content-Type":
                "application/json",

              Authorization:
                "Bearer " +
                token,
            },

            body:
              JSON.stringify({
                action:
                  "request",

                reason,
              }),
          }
        );

      const body =
        await parseResponse(
          response
        );

      setState(
        body
      );

      setMessage(
        body.message ??
          "Demande envoyee."
      );

      setOpened(
        false
      );
    } catch (error) {
      setErrorMessage(
        error instanceof Error
          ? error.message
          : "Envoi impossible."
      );
    } finally {
      setSaving(
        false
      );
    }
  }

  async function withdrawRequest() {
    setSaving(true);
    setMessage("");
    setErrorMessage("");

    try {
      const token =
        await accessToken();

      const response =
        await fetch(
          "/api/booking-groups/" +
            encodeURIComponent(
              groupId
            ) +
            "/cancellation",
          {
            method:
              "POST",

            headers: {
              "Content-Type":
                "application/json",

              Authorization:
                "Bearer " +
                token,
            },

            body:
              JSON.stringify({
                action:
                  "withdraw",
              }),
          }
        );

      const body =
        await parseResponse(
          response
        );

      setState(
        body
      );

      setMessage(
        body.message ??
          "Demande retiree."
      );
    } catch (error) {
      setErrorMessage(
        error instanceof Error
          ? error.message
          : "Retrait impossible."
      );
    } finally {
      setSaving(
        false
      );
    }
  }

  const terminal =
    groupStatus ===
      "completed" ||
    groupStatus ===
      "cancelled";

  if (
    loading
  ) {
    return (
      <div className="mt-6 flex items-center gap-2 rounded-2xl border border-border bg-card p-4 text-sm text-muted-foreground">
        <LoaderCircle
          size={17}
          className="animate-spin"
        />

        Verification des options d annulation...
      </div>
    );
  }

  if (
    terminal &&
    state?.cancellationStatus !==
      "requested"
  ) {
    return null;
  }

  return (
    <section className="mt-6 rounded-3xl border border-border bg-card p-5 sm:p-6">
      <div className="flex items-start gap-3">
        <div className="grid h-10 w-10 shrink-0 place-items-center rounded-2xl bg-amber-500/10 text-amber-600">
          <ShieldCheck
            size={20}
          />
        </div>

        <div className="min-w-0 flex-1">
          <h2 className="font-black">
            Annulation de la mission groupee
          </h2>

          <p className="mt-1 text-sm leading-6 text-muted-foreground">
            Une demande concerne toujours le groupe complet.
            Aucun creneau enfant ne doit etre annule ou rembourse
            independamment.
          </p>
        </div>
      </div>

      {state?.cancellationStatus ===
        "requested" ? (
        <div className="mt-5 rounded-2xl border border-amber-500/30 bg-amber-500/10 p-4">
          <div className="flex items-start gap-3">
            <AlertTriangle
              size={19}
              className="mt-0.5 shrink-0 text-amber-600"
            />

            <div>
              <p className="font-black text-amber-800 dark:text-amber-200">
                Demande d annulation ouverte
              </p>

              <p className="mt-2 text-sm leading-6 text-amber-800/80 dark:text-amber-200/80">
                {state.isRequester
                  ? "Ta demande est enregistree. KLYX n a encore annule aucune reservation."
                  : state.requestedRole ===
                      "client"
                    ? "Le client a demande l annulation de toute la mission."
                    : "Le prestataire a demande l annulation de toute la mission."}
              </p>

              {state.reason && (
                <div className="mt-3 rounded-xl bg-background/70 p-3 text-sm">
                  <strong>
                    Motif :
                  </strong>{" "}
                  {state.reason}
                </div>
              )}

              {paymentStatus ===
                "paid" && (
                <p className="mt-3 text-sm font-bold text-amber-900 dark:text-amber-100">
                  Le groupe est deja paye. Aucun remboursement
                  Stripe n est declenche automatiquement.
                </p>
              )}

              {state.canWithdraw && (
                <button
                  type="button"
                  disabled={
                    saving
                  }
                  onClick={() =>
                    void withdrawRequest()
                  }
                  className="mt-4 inline-flex h-11 items-center justify-center gap-2 rounded-xl border border-border bg-background px-4 text-sm font-black transition hover:bg-muted disabled:opacity-60"
                >
                  {saving ? (
                    <LoaderCircle
                      size={16}
                      className="animate-spin"
                    />
                  ) : (
                    <RotateCcw
                      size={16}
                    />
                  )}

                  Retirer ma demande
                </button>
              )}
            </div>
          </div>
        </div>
      ) : (
        <>
          {!opened ? (
            <button
              type="button"
              disabled={
                !state?.canRequest
              }
              onClick={() =>
                setOpened(
                  true
                )
              }
              className="mt-5 inline-flex h-11 items-center justify-center gap-2 rounded-xl border border-red-500/30 bg-red-500/10 px-4 text-sm font-black text-red-700 transition hover:bg-red-500/15 disabled:cursor-not-allowed disabled:opacity-50 dark:text-red-300"
            >
              <XCircle
                size={17}
              />

              Demander l annulation du groupe
            </button>
          ) : (
            <form
              onSubmit={
                requestCancellation
              }
              className="mt-5 space-y-4"
            >
              <div>
                <label
                  htmlFor="group-cancellation-reason"
                  className="text-sm font-black"
                >
                  Pourquoi souhaites-tu annuler ?
                </label>

                <textarea
                  id="group-cancellation-reason"
                  value={
                    reason
                  }
                  maxLength={
                    500
                  }
                  rows={
                    4
                  }
                  onChange={(
                    event
                  ) =>
                    setReason(
                      event.target.value
                    )
                  }
                  placeholder="Explique clairement la raison..."
                  className="mt-2 w-full resize-y rounded-2xl border border-border bg-background px-4 py-3 text-sm outline-none focus:border-violet-500 focus:ring-4 focus:ring-violet-500/10"
                />

                <p className="mt-1 text-right text-xs text-muted-foreground">
                  {reason.length}
                  /500
                </p>
              </div>

              <div className="rounded-xl border border-border bg-muted/40 p-3 text-xs leading-5 text-muted-foreground">
                Cette action ouvre seulement une demande.
                Elle ne supprime pas les reservations et ne
                rembourse aucun paiement.
              </div>

              <div className="flex flex-col gap-2 sm:flex-row">
                <button
                  type="button"
                  disabled={
                    saving
                  }
                  onClick={() =>
                    setOpened(
                      false
                    )
                  }
                  className="inline-flex h-11 flex-1 items-center justify-center rounded-xl border border-border px-4 text-sm font-black"
                >
                  Retour
                </button>

                <button
                  type="submit"
                  disabled={
                    saving ||
                    reason.trim().length <
                      10
                  }
                  className="inline-flex h-11 flex-1 items-center justify-center gap-2 rounded-xl bg-red-600 px-4 text-sm font-black text-white hover:bg-red-700 disabled:opacity-50"
                >
                  {saving && (
                    <LoaderCircle
                      size={16}
                      className="animate-spin"
                    />
                  )}

                  Confirmer la demande
                </button>
              </div>
            </form>
          )}
        </>
      )}

      {message && (
        <div className="mt-4 flex items-center gap-2 rounded-xl border border-emerald-500/30 bg-emerald-500/10 p-3 text-sm font-bold text-emerald-700 dark:text-emerald-300">
          <CheckCircle2
            size={17}
          />

          {message}
        </div>
      )}

      {errorMessage && (
        <div className="mt-4 rounded-xl border border-red-500/30 bg-red-500/10 p-3 text-sm text-red-700 dark:text-red-300">
          {errorMessage}
        </div>
      )}
    </section>
  );
}