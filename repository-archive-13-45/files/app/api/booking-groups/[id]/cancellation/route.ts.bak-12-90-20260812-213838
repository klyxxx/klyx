import {
  NextResponse,
} from "next/server";

import {
  apiErrorStatus,
  getAuthenticatedProfile,
} from "@/lib/api-auth";

import {
  supabaseAdmin,
} from "@/lib/supabase-admin";

// KLYX_GROUP_CANCELLATION_API_12_89
// KLYX_GROUPROW_SUPABASE_FIX_12_89C

type ParticipantRole =
  | "client"
  | "provider";

type CancellationStatus =
  | "none"
  | "requested"
  | "withdrawn"
  | "resolved";

type GroupRow = {
  id: string;

  market_request_id:
    | string
    | null;

  client_profile_id:
    string;

  provider_profile_id:
    string;

  status:
    string;

  payment_status:
    string;

  cancellation_request_status:
    CancellationStatus;

  cancellation_requested_by:
    | string
    | null;

  cancellation_requested_role:
    | ParticipantRole
    | null;

  cancellation_reason:
    | string
    | null;

  cancellation_requested_at:
    | string
    | null;

  cancellation_withdrawn_at:
    | string
    | null;

  refund_status:
    string;
};

type RouteContext = {
  params:
    Promise<{
      id: string;
    }>;
};

function participantRole(
  group: GroupRow,
  profileId: string
): ParticipantRole | null {
  if (
    group.client_profile_id ===
    profileId
  ) {
    return "client";
  }

  if (
    group.provider_profile_id ===
    profileId
  ) {
    return "provider";
  }

  return null;
}

function otherParticipantId(
  group: GroupRow,
  role: ParticipantRole
) {
  return role === "client"
    ? group.provider_profile_id
    : group.client_profile_id;
}

async function loadGroup(
  groupId: string
): Promise<GroupRow> {
  const {
    data,
    error,
  } = await supabaseAdmin
    .from(
      "booking_groups"
    )
    .select(
      [
        "id",
        "market_request_id",
        "client_profile_id",
        "provider_profile_id",
        "status",
        "payment_status",
        "cancellation_request_status",
        "cancellation_requested_by",
        "cancellation_requested_role",
        "cancellation_reason",
        "cancellation_requested_at",
        "cancellation_withdrawn_at",
        "refund_status",
      ].join(", ")
    )
    .eq(
      "id",
      groupId
    )
    .maybeSingle();

  if (error) {
    throw new Error(
      error.message
    );
  }

  if (!data) {
    throw new Error(
      "Mission groupee introuvable."
    );
  }

  return data as unknown as GroupRow;
}

function responsePayload(
  group: GroupRow,
  role: ParticipantRole,
  profileId: string
) {
  const active =
    group.cancellation_request_status ===
    "requested";

  const requester =
    active &&
    group.cancellation_requested_by ===
      profileId;

  const terminal =
    group.status ===
      "completed" ||
    group.status ===
      "cancelled";

  return {
    groupId:
      group.id,

    role,

    groupStatus:
      group.status,

    paymentStatus:
      group.payment_status,

    cancellationStatus:
      group.cancellation_request_status,

    requestedBy:
      group.cancellation_requested_by,

    requestedRole:
      group.cancellation_requested_role,

    reason:
      group.cancellation_reason,

    requestedAt:
      group.cancellation_requested_at,

    withdrawnAt:
      group.cancellation_withdrawn_at,

    refundStatus:
      group.refund_status,

    isRequester:
      requester,

    canRequest:
      !terminal &&
      !active,

    canWithdraw:
      active &&
      requester,

    automaticCancellation:
      false,

    automaticRefund:
      false,

    requiresFinancialResolution:
      group.payment_status ===
      "paid",
  };
}

async function notifyParticipant(
  params: {
    recipientId: string;
    groupId: string;
    marketRequestId:
      | string
      | null;
    title: string;
    message: string;
    key: string;
  }
) {
  const {
    recipientId,
    groupId,
    marketRequestId,
    title,
    message,
    key,
  } = params;

  const {
    error,
  } = await supabaseAdmin
    .from(
      "user_notifications"
    )
    .upsert(
      {
        user_id:
          recipientId,

        market_request_id:
          marketRequestId,

        type:
          "system",

        title,

        message,

        href:
          "/booking-groups/" +
          groupId,

        deduplication_key:
          key,
      },
      {
        onConflict:
          "deduplication_key",

        ignoreDuplicates:
          true,
      }
    );

  if (error) {
    console.error(
      "Group cancellation notification:",
      error.message
    );
  }
}

export async function GET(
  request: Request,
  context: RouteContext
) {
  try {
    const {
      profile,
    } =
      await getAuthenticatedProfile(
        request
      );

    const {
      id,
    } =
      await context.params;

    const groupId =
      id?.trim();

    if (!groupId) {
      return NextResponse.json(
        {
          error:
            "Mission groupee manquante.",
        },
        {
          status: 400,
        }
      );
    }

    const group =
      await loadGroup(
        groupId
      );

    const role =
      participantRole(
        group,
        profile.id
      );

    if (!role) {
      return NextResponse.json(
        {
          error:
            "Acces refuse.",
        },
        {
          status: 403,
        }
      );
    }

    return NextResponse.json(
      responsePayload(
        group,
        role,
        profile.id
      )
    );
  } catch (error) {
    const message =
      error instanceof Error
        ? error.message
        : "Impossible de charger la demande d annulation.";

    return NextResponse.json(
      {
        error: message,
      },
      {
        status:
          apiErrorStatus(
            message
          ),
      }
    );
  }
}

export async function POST(
  request: Request,
  context: RouteContext
) {
  try {
    const {
      profile,
    } =
      await getAuthenticatedProfile(
        request
      );

    const {
      id,
    } =
      await context.params;

    const groupId =
      id?.trim();

    if (!groupId) {
      return NextResponse.json(
        {
          error:
            "Mission groupee manquante.",
        },
        {
          status: 400,
        }
      );
    }

    const body =
      (await request.json()) as {
        action?:
          | "request"
          | "withdraw";

        reason?: string;
      };

    const action =
      body.action;

    if (
      action !== "request" &&
      action !== "withdraw"
    ) {
      return NextResponse.json(
        {
          error:
            "Action invalide.",
        },
        {
          status: 400,
        }
      );
    }

    const group =
      await loadGroup(
        groupId
      );

    const role =
      participantRole(
        group,
        profile.id
      );

    if (!role) {
      return NextResponse.json(
        {
          error:
            "Acces refuse.",
        },
        {
          status: 403,
        }
      );
    }

    if (
      action === "request"
    ) {
      if (
        group.status ===
          "completed" ||
        group.status ===
          "cancelled"
      ) {
        return NextResponse.json(
          {
            error:
              "Cette mission ne peut plus recevoir une nouvelle demande d annulation.",
          },
          {
            status: 409,
          }
        );
      }

      if (
        group.cancellation_request_status ===
        "requested"
      ) {
        return NextResponse.json(
          {
            ...responsePayload(
              group,
              role,
              profile.id
            ),

            error:
              "Une demande d annulation est deja ouverte.",

            alreadyRequested:
              true,
          },
          {
            status: 409,
          }
        );
      }

      const reason =
        body.reason
          ?.trim()
          .slice(
            0,
            500
          ) ??
        "";

      if (
        reason.length < 10
      ) {
        return NextResponse.json(
          {
            error:
              "Explique la raison de l annulation en au moins 10 caracteres.",
          },
          {
            status: 400,
          }
        );
      }

      const now =
        new Date()
          .toISOString();

      const {
        data:
          updatedData,

        error:
          updateError,
      } = await supabaseAdmin
        .from(
          "booking_groups"
        )
        .update({
          cancellation_request_status:
            "requested",

          cancellation_requested_by:
            profile.id,

          cancellation_requested_role:
            role,

          cancellation_reason:
            reason,

          cancellation_requested_at:
            now,

          cancellation_withdrawn_at:
            null,
        })
        .eq(
          "id",
          group.id
        )
        .in(
          "cancellation_request_status",
          [
            "none",
            "withdrawn",
            "resolved",
          ]
        )
        .select(
          [
            "id",
            "market_request_id",
            "client_profile_id",
            "provider_profile_id",
            "status",
            "payment_status",
            "cancellation_request_status",
            "cancellation_requested_by",
            "cancellation_requested_role",
            "cancellation_reason",
            "cancellation_requested_at",
            "cancellation_withdrawn_at",
            "refund_status",
          ].join(", ")
        )
        .maybeSingle();

      if (updateError) {
        throw new Error(
          updateError.message
        );
      }

      if (!updatedData) {
        return NextResponse.json(
          {
            error:
              "Une autre demande vient deja d etre ouverte. Recharge la mission.",
          },
          {
            status: 409,
          }
        );
      }

      const updated =
        updatedData as unknown as GroupRow;

      const {
        error:
          auditError,
      } = await supabaseAdmin
        .from(
          "booking_group_cancellation_events"
        )
        .insert({
          booking_group_id:
            group.id,

          actor_profile_id:
            profile.id,

          actor_role:
            role,

          action:
            "requested",

          reason,
        });

      if (auditError) {
        console.error(
          "Group cancellation audit:",
          auditError.message
        );
      }

      const recipientId =
        otherParticipantId(
          group,
          role
        );

      await notifyParticipant({
        recipientId,

        groupId:
          group.id,

        marketRequestId:
          group.market_request_id,

        title:
          "Demande d annulation",

        message:
          role === "client"
            ? "Le client demande l annulation de la mission groupee."
            : "Le prestataire demande l annulation de la mission groupee.",

        key:
          "booking-group:" +
          group.id +
          ":cancel-request:" +
          now,
      });

      return NextResponse.json({
        ...responsePayload(
          updated,
          role,
          profile.id
        ),

        message:
          "Demande d annulation envoyee.",

        automaticCancellation:
          false,

        automaticRefund:
          false,
      });
    }

    if (
      group.cancellation_request_status !==
      "requested"
    ) {
      return NextResponse.json(
        {
          error:
            "Aucune demande d annulation active.",
        },
        {
          status: 409,
        }
      );
    }

    if (
      group.cancellation_requested_by !==
      profile.id
    ) {
      return NextResponse.json(
        {
          error:
            "Seule la personne qui a ouvert la demande peut la retirer.",
        },
        {
          status: 403,
        }
      );
    }

    const now =
      new Date()
        .toISOString();

    const {
      data:
        withdrawnData,

      error:
        withdrawError,
    } = await supabaseAdmin
      .from(
        "booking_groups"
      )
      .update({
        cancellation_request_status:
          "withdrawn",

        cancellation_withdrawn_at:
          now,
      })
      .eq(
        "id",
        group.id
      )
      .eq(
        "cancellation_request_status",
        "requested"
      )
      .eq(
        "cancellation_requested_by",
        profile.id
      )
      .select(
        [
          "id",
          "market_request_id",
          "client_profile_id",
          "provider_profile_id",
          "status",
          "payment_status",
          "cancellation_request_status",
          "cancellation_requested_by",
          "cancellation_requested_role",
          "cancellation_reason",
          "cancellation_requested_at",
          "cancellation_withdrawn_at",
          "refund_status",
        ].join(", ")
      )
      .maybeSingle();

    if (withdrawError) {
      throw new Error(
        withdrawError.message
      );
    }

    if (!withdrawnData) {
      return NextResponse.json(
        {
          error:
            "La demande a deja change d etat.",
        },
        {
          status: 409,
        }
      );
    }

    const withdrawn =
      withdrawnData as unknown as GroupRow;

    const {
      error:
        auditError,
    } = await supabaseAdmin
      .from(
        "booking_group_cancellation_events"
      )
      .insert({
        booking_group_id:
          group.id,

        actor_profile_id:
          profile.id,

        actor_role:
          role,

        action:
          "withdrawn",

        reason:
          group.cancellation_reason,
      });

    if (auditError) {
      console.error(
        "Group cancellation audit:",
        auditError.message
      );
    }

    const recipientId =
      otherParticipantId(
        group,
        role
      );

    await notifyParticipant({
      recipientId,

      groupId:
        group.id,

      marketRequestId:
        group.market_request_id,

      title:
        "Demande d annulation retiree",

      message:
        "La demande d annulation de la mission groupee a ete retiree.",

      key:
        "booking-group:" +
        group.id +
        ":cancel-withdraw:" +
        now,
    });

    return NextResponse.json({
      ...responsePayload(
        withdrawn,
        role,
        profile.id
      ),

      message:
        "Demande retiree.",

      automaticCancellation:
        false,

      automaticRefund:
        false,
    });
  } catch (error) {
    const message =
      error instanceof Error
        ? error.message
        : "Impossible de traiter la demande d annulation.";

    return NextResponse.json(
      {
        error: message,
      },
      {
        status:
          apiErrorStatus(
            message
          ),
      }
    );
  }
}